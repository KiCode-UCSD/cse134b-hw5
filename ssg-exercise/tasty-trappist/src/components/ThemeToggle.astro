<!--Light/Dark mode toggle, make invisible until js loads-->
<div id="toggle_container" style="opacity: 0;">
    <!--set checkbox default to dark mode, tabindex=0 is so keyboards can access it-->
    <input type="checkbox" id="mode_toggle" name="mode_toggle" tabindex="0" checked>
    <label id="slider" for="mode_toggle" aria-label="Light/dark mode toggle"></label>
    <!--<span id="slider"></span>-->
</div>
